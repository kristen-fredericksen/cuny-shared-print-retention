# Alma API Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to git!

# Network Zone API keys
ALMA_NZ_API_KEY=your_production_nz_key_here
ALMA_SANDBOX_NZ_API_KEY=your_sandbox_nz_key_here

# Alma API base URL (North America)
ALMA_API_BASE_URL=https://api-na.hosted.exlibrisgroup.com
ALMA_SANDBOX_API_BASE_URL=https://api-na.hosted.exlibrisgroup.com

# Schools file location (institution metadata — no API keys)
SCHOOLS_FILE=data/schools_template.csv
ALMA_SANDBOX_SCHOOLS_FILE=data/schools_sandbox.csv

# Per-campus API keys — Production
# Add a line for each school that participates in Shared Print.
# The campus code is the part after '01CUNY_' in the Alma Institution Code.
# Example: Alma Institution Code '01CUNY_QC' -> ALMA_PROD_QC
ALMA_PROD_BB=your_baruch_key_here
ALMA_PROD_BC=your_brooklyn_key_here
ALMA_PROD_CC=your_citycollege_key_here
ALMA_PROD_GC=your_gradcenter_key_here
ALMA_PROD_JJ=your_johnjay_key_here
ALMA_PROD_KB=your_kingsborough_key_here
ALMA_PROD_LE=your_lehman_key_here
ALMA_PROD_QC=your_queens_key_here
ALMA_PROD_SI=your_statenisland_key_here

# Per-campus API keys — Sandbox
# Only needed for schools you want to test in sandbox mode.
ALMA_SANDBOX_CC=your_sandbox_citycollege_key_here
ALMA_SANDBOX_QC=your_sandbox_queens_key_here
