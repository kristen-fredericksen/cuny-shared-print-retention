# Alma API Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to git!

# Your Alma API key (get this from your Alma administrator)
ALMA_API_KEY=paste_your_api_key_here

# Alma API base URL - uncomment the one for your region:
# North America (default):
ALMA_API_BASE_URL=https://api-na.hosted.exlibrisgroup.com
# Europe:
# ALMA_API_BASE_URL=https://api-eu.hosted.exlibrisgroup.com
# Asia Pacific:
# ALMA_API_BASE_URL=https://api-ap.hosted.exlibrisgroup.com
